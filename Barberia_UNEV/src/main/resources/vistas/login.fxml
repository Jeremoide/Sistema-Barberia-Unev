<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.unev.barberia.controlador.LoginController" alignment="CENTER" spacing="14" prefWidth="520" prefHeight="570" styleClass="pagina">
 <padding><Insets top="38" right="48" bottom="38" left="48"/></padding>
 <Label text="BARBERÍA UNEV" styleClass="marca"/><Label text="Bienvenido" styleClass="titulo"/><Label text="Inicie sesión para gestionar su barbería." wrapText="true"/>
 <Label text="Nombre de usuario" maxWidth="Infinity"/><TextField fx:id="usuario" promptText="Su usuario" onAction="#iniciar"/>
 <Label text="Contraseña" maxWidth="Infinity"/><PasswordField fx:id="clave" promptText="Su contraseña" onAction="#iniciar"/>
 <Button text="Iniciar sesión" onAction="#iniciar" defaultButton="true" maxWidth="Infinity" styleClass="primario"/>
 <HBox alignment="CENTER" spacing="16"><Button text="Crear cuenta" onAction="#registrar"/><Button text="Salir" onAction="#salir" cancelButton="true"/></HBox>
 <Label fx:id="mensaje" wrapText="true" minHeight="50" maxWidth="Infinity" styleClass="mensaje"/>
 <Label text="Cuenta de demostración: admin / Admin123!" styleClass="nota"/>
</VBox>
